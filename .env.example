# Personal Finance Advisor Bot Environment Configuration
# Copy this file to .env and insert your actual configuration values.

# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Application Secret Key for session signing
SECRET_KEY=generate-a-secure-random-secret-key

# Server settings
PORT=5000
FLASK_DEBUG=1
